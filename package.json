{
	"name": "typefully",
	"version": "0.0.1",
	"type": "module",
	"bin": {
		"typefully": "./dist/index.js"
	},
	"main": "./dist/index.js",
	"files": [
		"dist",
		"skills"
	],
	"scripts": {
		"dev": "tsup --watch",
		"build": "tsup",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"format": "biome format --write ."
	},
	"engines": {
		"node": ">=18"
	},
	"dependencies": {
		"@clack/prompts": "^1.0.1",
		"commander": "^14.0.3",
		"ora": "^9.3.0",
		"picocolors": "^1.1.1",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.2",
		"@types/node": "^25.2.3",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18"
	}
}
